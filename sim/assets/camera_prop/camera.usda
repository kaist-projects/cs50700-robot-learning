#usda 1.0
(
    defaultPrim = "CameraProp"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Handheld rangefinder camera with a pressable shutter button.

    Visuals: Poly Haven "Camera 01" (CC0, Rajil Jose Macatangay), split in Blender into
    visuals/camera_body.usdc and visuals/shutter_button.usdc (source: source/camera_01_split.blend).
    Frame: origin at the bottom centre, lens along +x, width along y, z up.

    Physics: floating-base articulation with two links. Colliders are simple primitives,
    slightly inside the visual mesh, and hidden from rendering with purpose "guide".
    - body: main box up to the top-plate height around the button, plus the lens cylinder.
    - shutter_button: the release-button head on a prismatic joint along +z, from
      0 (released) to -4 mm (fully pressed). The Isaac Lab actuator config sets the spring."""
)

def Xform "CameraProp" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.4

        def Xform "visual" (
            prepend references = @./visuals/camera_body.usdc@
        )
        {
        }

        def Cube "housing_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double size = 1
            double3 xformOp:translate = (0.0005, 0.0001, 0.036)
            float3 xformOp:scale = (0.035, 0.136, 0.071)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "lens_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            uniform token axis = "X"
            double height = 0.052
            double radius = 0.025
            double3 xformOp:translate = (0.0442, 0.0099, 0.0338)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "shutter_button" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.01
        double3 xformOp:translate = (0.0058, -0.0437, 0.07326)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "visual" (
            prepend references = @./visuals/shutter_button.usdc@
        )
        {
        }

        def Cylinder "head_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            uniform token axis = "Z"
            double height = 0.0048
            double radius = 0.0075
            double3 xformOp:translate = (0, 0, 0.0024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsPrismaticJoint "shutter_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </CameraProp/body>
        rel physics:body1 = </CameraProp/shutter_button>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0.0058, -0.0437, 0.07326)
        quatf physics:localRot0 = (1, 0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -0.004
        float physics:upperLimit = 0
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:stiffness = 500
        float drive:linear:physics:damping = 5
        float drive:linear:physics:targetPosition = 0
    }
}
